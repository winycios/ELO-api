# Banco de dados MySQL
DB_URL=jdbc:mysql://localhost:3306/database_elo?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Chave secreta do JWT (Base64)
JWT_SECRET_KEY=

# Redis (sessões de refresh token) — HEXPIRE exige Redis 7.4+
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_NAME=profissionais_search_v1

# 300000 ms = 5 minutos
ELASTICSEARCH_OUTBOX_DELAY_MS=300000
ELASTICSEARCH_OUTBOX_INITIAL_DELAY_MS=300000
ELASTICSEARCH_OUTBOX_MAX_ATTEMPTS=10
ELASTICSEARCH_INITIAL_REINDEX_ENABLED=true

# Notificacoes
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false

# Firebase Admin SDK.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=secret/example.json

# E-mail SMTP
NOTIFICATION_EMAIL_FROM=no-reply@elo.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=true

# Storage de imagens (S3/MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=elo-local
STORAGE_SECRET_KEY=elo-local-secret
STORAGE_PATH_STYLE=true
STORAGE_BUCKET_PUBLICO=elo-publico
STORAGE_BUCKET_PRIVADO=elo-privado
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_PRESIGNED_EXPIRATION_SECONDS=3600
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# Outbox de notificacoes
NOTIFICATION_OUTBOX_DELAY_MS=3000
NOTIFICATION_OUTBOX_INITIAL_DELAY_MS=5000
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=10
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=3600
